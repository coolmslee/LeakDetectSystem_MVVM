<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Primary Colors ===== -->
    <Color x:Key="PrimaryColor">#1E3A5F</Color>
    <Color x:Key="PrimaryLightColor">#2D5A8E</Color>
    <Color x:Key="PrimaryDarkColor">#0F1F33</Color>

    <!-- ===== Accent Colors ===== -->
    <Color x:Key="AccentColor">#00A8CC</Color>
    <Color x:Key="AccentLightColor">#33C3E0</Color>

    <!-- ===== Status Colors ===== -->
    <Color x:Key="NormalStatusColor">#2ECC71</Color>
    <Color x:Key="WarningStatusColor">#F39C12</Color>
    <Color x:Key="ErrorStatusColor">#E74C3C</Color>
    <Color x:Key="InactiveStatusColor">#95A5A6</Color>

    <!-- ===== Background Colors ===== -->
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#ECEFF1</Color>

    <!-- ===== Text Colors ===== -->
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- ===== Border Colors ===== -->
    <Color x:Key="BorderColor">#BDBDBD</Color>
    <Color x:Key="DividerColor">#E0E0E0</Color>

    <!-- ===== SolidColorBrush 정의 (Colors와 독립적으로 직접 정의하여 parse-time StaticResource 의존 제거) ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"              Color="#1E3A5F" />
    <SolidColorBrush x:Key="PrimaryLightBrush"         Color="#2D5A8E" />
    <SolidColorBrush x:Key="PrimaryDarkBrush"          Color="#0F1F33" />
    <SolidColorBrush x:Key="AccentBrush"               Color="#00A8CC" />
    <SolidColorBrush x:Key="AccentLightBrush"          Color="#33C3E0" />
    <SolidColorBrush x:Key="NormalStatusBrush"         Color="#2ECC71" />
    <SolidColorBrush x:Key="WarningStatusBrush"        Color="#F39C12" />
    <SolidColorBrush x:Key="ErrorStatusBrush"          Color="#E74C3C" />
    <SolidColorBrush x:Key="InactiveStatusBrush"       Color="#95A5A6" />
    <SolidColorBrush x:Key="InactiveStatusHoverBrush"  Color="#808B8C" />
    <SolidColorBrush x:Key="InactiveStatusPressedBrush" Color="#6B7879" />
    <SolidColorBrush x:Key="BackgroundBrush"           Color="#F5F5F5" />
    <SolidColorBrush x:Key="SurfaceBrush"              Color="#FFFFFF" />
    <SolidColorBrush x:Key="PanelBackgroundBrush"      Color="#ECEFF1" />
    <SolidColorBrush x:Key="TextPrimaryBrush"          Color="#212121" />
    <SolidColorBrush x:Key="TextSecondaryBrush"        Color="#757575" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush"        Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardBorderBrush"           Color="#BDBDBD" />
    <SolidColorBrush x:Key="DividerBrush"              Color="#E0E0E0" />

</ResourceDictionary>
