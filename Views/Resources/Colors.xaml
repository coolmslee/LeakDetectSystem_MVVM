<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ===== Primary Colors ===== -->
    <Color x:Key="PrimaryColor">#1E3A5F</Color>
    <Color x:Key="PrimaryLightColor">#2D5A8E</Color>
    <Color x:Key="PrimaryDarkColor">#0F1F33</Color>

    <!-- ===== Accent Colors ===== -->
    <Color x:Key="AccentColor">#00A8CC</Color>
    <Color x:Key="AccentLightColor">#33C3E0</Color>

    <!-- ===== Status Colors ===== -->
    <Color x:Key="NormalStatusColor">#2ECC71</Color>
    <Color x:Key="WarningStatusColor">#F39C12</Color>
    <Color x:Key="ErrorStatusColor">#E74C3C</Color>
    <Color x:Key="InactiveStatusColor">#95A5A6</Color>

    <!-- ===== Background Colors ===== -->
    <Color x:Key="BackgroundColor">#F5F5F5</Color>
    <Color x:Key="SurfaceColor">#FFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#ECEFF1</Color>

    <!-- ===== Text Colors ===== -->
    <Color x:Key="TextPrimaryColor">#212121</Color>
    <Color x:Key="TextSecondaryColor">#757575</Color>
    <Color x:Key="TextOnPrimaryColor">#FFFFFF</Color>

    <!-- ===== Border Colors ===== -->
    <Color x:Key="BorderColor">#BDBDBD</Color>
    <Color x:Key="DividerColor">#E0E0E0</Color>

    <!-- ===== SolidColorBrush 변환 ===== -->
    <SolidColorBrush x:Key="PrimaryBrush"         Color="{StaticResource PrimaryColor}" />
    <SolidColorBrush x:Key="PrimaryLightBrush"    Color="{StaticResource PrimaryLightColor}" />
    <SolidColorBrush x:Key="PrimaryDarkBrush"     Color="{StaticResource PrimaryDarkColor}" />
    <SolidColorBrush x:Key="AccentBrush"          Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentLightBrush"     Color="{StaticResource AccentLightColor}" />
    <SolidColorBrush x:Key="NormalStatusBrush"    Color="{StaticResource NormalStatusColor}" />
    <SolidColorBrush x:Key="WarningStatusBrush"   Color="{StaticResource WarningStatusColor}" />
    <SolidColorBrush x:Key="ErrorStatusBrush"     Color="{StaticResource ErrorStatusColor}" />
    <SolidColorBrush x:Key="InactiveStatusBrush"  Color="{StaticResource InactiveStatusColor}" />
    <SolidColorBrush x:Key="InactiveStatusHoverBrush"  Color="#808B8C" />
    <SolidColorBrush x:Key="InactiveStatusPressedBrush" Color="#6B7879" />
    <SolidColorBrush x:Key="BackgroundBrush"      Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush"         Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="TextPrimaryBrush"     Color="{StaticResource TextPrimaryColor}" />
    <SolidColorBrush x:Key="TextSecondaryBrush"   Color="{StaticResource TextSecondaryColor}" />
    <SolidColorBrush x:Key="TextOnPrimaryBrush"   Color="{StaticResource TextOnPrimaryColor}" />
    <SolidColorBrush x:Key="BorderBrush"          Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="DividerBrush"         Color="{StaticResource DividerColor}" />

</ResourceDictionary>
