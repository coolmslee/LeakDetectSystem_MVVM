<Window x:Class="LeakDetectSystem_MVVM.Views.Dialogs.LogDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels.Dialogs"
        Title="로그" Height="400" Width="560"
        WindowStartupLocation="CenterOwner">
    <Window.DataContext>
        <vm:LogDialogViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="로그 보기" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <ListBox Grid.Row="1" ItemsSource="{Binding LogEntries}"
                 FontFamily="Consolas" FontSize="12"
                 BorderBrush="LightGray" BorderThickness="1" />

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" Width="80" Height="30" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
