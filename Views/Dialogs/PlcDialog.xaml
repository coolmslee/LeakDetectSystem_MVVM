<Window x:Class="LeakDetectSystem_MVVM.Views.Dialogs.PlcDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="PLC 통신"
        Width="1100"
        Height="626"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        Background="#292929">
    <Grid Margin="6">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="600" />
            <ColumnDefinition Width="500" />
        </Grid.ColumnDefinitions>

        <Grid Grid.Column="0" Margin="0,0,6,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="3*" />
                <RowDefinition Height="2*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="LightGray" BorderBrush="Black" BorderThickness="1" Padding="6">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="시작주소" FontSize="20" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="크기/결과" FontSize="20" FontWeight="Bold" TextAlignment="Center" VerticalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="1" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="데이타위치" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding StartAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding StartLength, UpdateSourceTrigger=PropertyChanged}" FontSize="16" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="2" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton Grid.Column="0" Content="Bit" IsChecked="{Binding IsBitMode}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <RadioButton Grid.Column="1" Content="Bin(Hex)" IsChecked="{Binding IsHexMode}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                        <RadioButton Grid.Column="2" Content="ASCII" IsChecked="{Binding IsAsciiMode}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="3" Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Data(Bit,Word)" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding WriteData, UpdateSourceTrigger=PropertyChanged}" FontSize="18" VerticalContentAlignment="Center" />
                    </Grid>

                    <Grid Grid.Row="4">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Receive Data" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,8,4" />
                        <Button Grid.Row="1" Grid.Column="0" Content="Clear" Command="{Binding ClearReceiveCommand}" FontSize="18" Margin="0,4,8,0" Height="36" />
                        <ListBox Grid.Row="0" Grid.Column="1" Grid.RowSpan="2" ItemsSource="{Binding ReceiveData}" />
                    </Grid>
                </Grid>
            </Border>

            <Border Grid.Row="1" Background="LightGray" BorderBrush="Black" BorderThickness="1" Padding="6" Margin="0,6,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Tray" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Text="Barcode" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding Barcode}" IsReadOnly="True" Margin="0,20,0,0" Height="24" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="2" Text="SEQNO" FontWeight="Bold" VerticalAlignment="Center" />
                        <TextBox Grid.Column="2" Text="{Binding SeqNo}" IsReadOnly="True" Margin="0,20,0,0" Height="24" VerticalContentAlignment="Center" />
                        <TextBlock Grid.Column="3" Text="외관" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <CheckBox Grid.Column="3" Content="Off" IsEnabled="False" Margin="0,20,0,0" HorizontalAlignment="Center" />
                        <TextBlock Grid.Column="4" Text="RF/LABEL" FontWeight="Bold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <CheckBox Grid.Column="4" Content="Off" IsEnabled="False" Margin="0,20,0,0" HorizontalAlignment="Center" />
                    </Grid>

                    <TextBlock Grid.Row="1" Text="(Legacy Tray/Barcode/Result section placeholder)" Foreground="DimGray" FontStyle="Italic" VerticalAlignment="Center" HorizontalAlignment="Center" />

                    <Button Grid.Row="2" Content="공병정보&#10;결과읽기" IsEnabled="False" FontSize="18" FontWeight="Bold" Height="72" Width="160" HorizontalAlignment="Left" />
                </Grid>
            </Border>
        </Grid>

        <Border Grid.Column="1" Background="LightGray" BorderBrush="Black" BorderThickness="1" Padding="6">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Status" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,4,4" />
                <Rectangle Grid.Row="0" Grid.Column="1" Fill="{Binding ConnectionBrush}" Height="32" Margin="0,0,0,4" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="IP" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding IpAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Port" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Port, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Read Address" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding ReadAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Read Length" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding ReadLength, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Read Unit" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding ReadUnit, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="6" Grid.Column="0" Text="공병정보요청 Addr." FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding WriteAddressOcr, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="7" Grid.Column="0" Text="공병정보응답 Addr." FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding WriteAddress1, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Palette Data Addr." FontSize="18" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding WriteAddress2, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="9" Grid.Column="0" Text="Write Unit" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="9" Grid.Column="1" Text="{Binding WriteUnit, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="10" Grid.Column="0" Text="Read Interval" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding ReadInterval, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <TextBlock Grid.Row="11" Grid.Column="0" Text="Heart Beat" FontSize="20" FontWeight="Bold" VerticalAlignment="Center" />
                <TextBox Grid.Row="11" Grid.Column="1" Text="{Binding HeartbeatAddress, UpdateSourceTrigger=PropertyChanged}" FontSize="20" Height="36" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                <Grid Grid.Row="14" Grid.ColumnSpan="2" Margin="0,8,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Row="0" Grid.Column="0" Content="Bit정보읽기" Command="{Binding ReadBitCommand}" FontSize="20" FontWeight="Bold" Height="52" Margin="0,0,4,6" />
                    <Button Grid.Row="0" Grid.Column="1" Content="Bit정보쓰기" Command="{Binding WriteBitCommand}" FontSize="20" FontWeight="Bold" Height="52" Margin="4,0,0,6" />
                    <Button Grid.Row="1" Grid.Column="0" Content="데이타읽기" Command="{Binding ReadDataCommand}" FontSize="20" FontWeight="Bold" Height="52" Margin="0,0,4,0" />
                    <Button Grid.Row="1" Grid.Column="1" Content="데이타쓰기" Command="{Binding WriteDataCommand}" FontSize="20" FontWeight="Bold" Height="52" Margin="4,0,0,0" />
                </Grid>

                <StackPanel Grid.Row="15" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
                    <Button Content="CONNECT" Command="{Binding ConnectCommand}" FontSize="20" FontWeight="Bold" Width="170" Height="56" Margin="0,0,8,0" />
                    <Button Content="EXIT" Command="{Binding ExitCommand}" FontSize="20" FontWeight="Bold" Width="120" Height="56" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
