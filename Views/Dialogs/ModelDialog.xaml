<Window x:Class="LeakDetectSystem_MVVM.Views.Dialogs.ModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Model 설정" Height="350" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Style="{StaticResource DialogWindowStyle}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="모델 설정" Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="모델 선택" Style="{StaticResource DialogLabelTextStyle}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding Models}" SelectedItem="{Binding SelectedModel}" Padding="4,3"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="모델명" Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding ModelName, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <Button Content="닫기" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</Window>
