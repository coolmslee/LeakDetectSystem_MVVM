<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.ModelDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Model 설정"
        Height="660"
        Width="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="모델 설정"
                   Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="200"/>
                    <ColumnDefinition Width="12"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 왼쪽: 모델 목록 -->
                <Border Grid.Column="0"
                        BorderBrush="{DynamicResource CardBorderBrush}"
                        BorderThickness="1"
                        Padding="8">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="모델 목록"
                                   Style="{StaticResource DialogHeaderLabelTextStyle}"
                                   Margin="0,0,0,8"/>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Models}"
                                 SelectedItem="{Binding SelectedModel}"
                                 DisplayMemberPath="ModelName"
                                 BorderThickness="0"
                                 Background="Transparent"/>
                    </Grid>
                </Border>

                <!-- 오른쪽: 편집 패널 -->
                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- 모델명 행 -->
                    <Grid Grid.Row="0"
                          Margin="0,0,0,8"
                          IsEnabled="{Binding HasSelectedModel}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="60"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="8"/>
                            <ColumnDefinition Width="70"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="모델명"
                                   Style="{StaticResource DialogLabelTextStyle}"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SelectedModel.ModelName, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource DialogInputTextBoxStyle}"/>
                        <Button Grid.Column="3"
                                Content="선택"
                                Width="70"
                                Style="{StaticResource DialogSecondaryButtonStyle}"
                                Command="{Binding ApplyModelCommand}"/>
                    </Grid>

                    <!-- CAM 영역 -->
                    <Border Grid.Row="1"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="1"
                            Padding="8"
                            IsEnabled="{Binding HasSelectedModel}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0"
                                       Text="CAM"
                                       Style="{StaticResource DialogHeaderLabelTextStyle}"
                                       Margin="0,0,0,8"/>

                            <!-- 2×2 CAM 배치 -->
                            <Grid Grid.Row="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition Height="6"/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition/>
                                    <ColumnDefinition Width="6"/>
                                    <ColumnDefinition/>
                                </Grid.ColumnDefinitions>

                                <!-- CAM #1 -->
                                <Border Grid.Row="0" Grid.Column="0"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CAM #1"
                                                   Style="{StaticResource DialogHeaderLabelTextStyle}"
                                                   Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VPP Name" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding SelectedModel.Cam1VppName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogInputTextBoxStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="노출 시간 (μs)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[0].ExposureTime}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="게인 (%)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[0].Gain}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Video Format" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[0].VideoFormat}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Timeout (ms)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[0].Timeout}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CAM #2 -->
                                <Border Grid.Row="0" Grid.Column="2"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CAM #2"
                                                   Style="{StaticResource DialogHeaderLabelTextStyle}"
                                                   Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VPP Name" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding SelectedModel.Cam2VppName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogInputTextBoxStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="노출 시간 (μs)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[1].ExposureTime}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="게인 (%)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[1].Gain}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Video Format" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[1].VideoFormat}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Timeout (ms)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[1].Timeout}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CAM #3 -->
                                <Border Grid.Row="2" Grid.Column="0"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CAM #3"
                                                   Style="{StaticResource DialogHeaderLabelTextStyle}"
                                                   Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VPP Name" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding SelectedModel.Cam3VppName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogInputTextBoxStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="노출 시간 (μs)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[2].ExposureTime}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="게인 (%)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[2].Gain}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Video Format" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[2].VideoFormat}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Timeout (ms)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[2].Timeout}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <!-- CAM #4 -->
                                <Border Grid.Row="2" Grid.Column="2"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="8">
                                    <StackPanel>
                                        <TextBlock Text="CAM #4"
                                                   Style="{StaticResource DialogHeaderLabelTextStyle}"
                                                   Margin="0,0,0,6"/>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="VPP Name" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBox Grid.Column="1"
                                                     Text="{Binding SelectedModel.Cam4VppName, UpdateSourceTrigger=PropertyChanged}"
                                                     Style="{StaticResource DialogInputTextBoxStyle}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="노출 시간 (μs)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[3].ExposureTime}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="게인 (%)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[3].Gain}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid Margin="0,0,0,3">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Video Format" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[3].VideoFormat}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="Timeout (ms)" Style="{StaticResource DialogLabelTextStyle}"/>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding CameraConfigs[3].Timeout}"
                                                       Style="{StaticResource DialogLabelTextStyle}"
                                                       Foreground="{DynamicResource TextSecondaryBrush}"/>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!-- 하단 버튼 영역 -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Content="추가"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding AddModelCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="수정"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding EditModelCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="삭제"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding DeleteModelCommand}"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="저장"
                        Style="{StaticResource DialogPrimaryButtonStyle}"
                        Command="{Binding SaveCommand}"
                        Margin="0,0,8,0"/>
                <Button Content="닫기"
                        IsCancel="True"
                        Style="{StaticResource DialogSecondaryButtonStyle}"
                        Command="{Binding CloseCommand}"/>
            </StackPanel>
        </Grid>
    </Grid>
</dialogs:DialogWindowBase>

