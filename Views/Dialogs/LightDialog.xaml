<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.LightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Light 설정"
        Height="540"
        Width="540"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="조명 설정"
                   Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Margin="0,0,0,12">
                    <TextBlock Text="누액검사 조명"
                               Style="{StaticResource DialogHeaderLabelTextStyle}"
                               FontSize="14"/>
                    <!--<TextBlock Margin="0,4,0,0"
                               Text="기존 LightWindow의 누액검사 조명 영역만 유지하고, 현재 다이얼로그 스타일에 맞춰 간단하게 구성했습니다."
                               Foreground="{DynamicResource TextSecondaryBrush}"
                               TextWrapping="Wrap"/>-->
                </StackPanel>

                <!-- COM Port -->
                <Grid Grid.Row="1" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="COM 포트"
                               Style="{StaticResource DialogLabelTextStyle}"
                               VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding ComPort, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Separator Grid.Row="2" Margin="0,0,0,12"/>

                <ScrollViewer Grid.Row="3"
                              VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Channels}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,10"
                                        Padding="10"
                                        BorderBrush="{DynamicResource CardBorderBrush}"
                                        BorderThickness="1">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="90"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Grid.ColumnSpan="2"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">
                                            <TextBlock Text="{Binding ChannelName}"
                                                       Style="{StaticResource DialogHeaderLabelTextStyle}"/>
                                            <CheckBox Margin="12,0,0,0"
                                                      VerticalAlignment="Center"
                                                      IsChecked="{Binding IsEnabled}"/>
                                            <TextBlock Margin="6,0,0,0"
                                                       Text="사용"
                                                       Style="{StaticResource DialogLabelTextStyle}"/>
                                        </StackPanel>

                                        <TextBlock Grid.Row="0"
                                                   Grid.Column="2"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding CurrentValueText}"
                                                   Style="{StaticResource DialogLabelTextStyle}"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="0"
                                                   Margin="0,10,0,0"
                                                   Text="밝기"
                                                   Style="{StaticResource DialogLabelTextStyle}"/>

                                        <Slider Grid.Row="1"
                                                Grid.Column="1"
                                                Margin="12,10,12,0"
                                                Minimum="0"
                                                Maximum="255"
                                                TickFrequency="5"
                                                Value="{Binding Brightness}"
                                                IsEnabled="{Binding IsEnabled}"
                                                VerticalAlignment="Center"/>

                                        <TextBlock Grid.Row="1"
                                                   Grid.Column="2"
                                                   Margin="0,10,0,0"
                                                   HorizontalAlignment="Right"
                                                   Text="{Binding PendingValueText}"
                                                   Style="{StaticResource DialogHeaderLabelTextStyle}"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>

                <TextBlock Grid.Row="4"
                           Margin="0,4,0,0"
                           Text="{Binding StatusMessage}"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <Button Content="저장"
                    Margin="0,0,8,0"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"/>
            <Button Content="적용"
                    Margin="0,0,8,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding ApplyCommand}"/>
            <Button Content="닫기"
                    IsCancel="True"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
