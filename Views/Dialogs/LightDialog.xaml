<Window x:Class="LeakDetectSystem_MVVM.Views.Dialogs.LightDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels.Dialogs"
        Title="Light 설정" Height="360" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:LightDialogViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="조명 설정" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="12">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CH1 밝기" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Channel1}" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CH2 밝기" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Channel2}" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CH3 밝기" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Channel3}" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CH4 밝기" VerticalAlignment="Center"/>
                    <Slider Grid.Column="1" Value="{Binding Channel4}" Minimum="0" Maximum="255" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" Width="80" Height="30" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
