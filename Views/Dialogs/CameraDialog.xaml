<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.CameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Camera 설정"
        Height="430"
        Width="520"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="카메라 설정"
                   Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="카메라 선택"
                               Style="{StaticResource DialogLabelTextStyle}"/>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Cameras}"
                              SelectedItem="{Binding SelectedCamera}"
                              DisplayMemberPath="Label"
                              Padding="4,3"/>
                </Grid>

                <Separator Margin="0,4,0,10"/>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="사용 여부"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding SelectedCamera.Use}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="IP Address"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedCamera.Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding SelectedCamera.Use}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Video Format"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding VideoFormats}"
                              SelectedItem="{Binding SelectedCamera.VideoFormat}"
                              IsEnabled="{Binding SelectedCamera.Use}"
                              Padding="4,3"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="노출 시간 (μs)"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedCamera.ExposureTime, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding SelectedCamera.Use}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="게인 (%)"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedCamera.Gain, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding SelectedCamera.Use}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Timeout 사용"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding SelectedCamera.TimeoutEnabled}"
                              IsEnabled="{Binding SelectedCamera.Use}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Timeout (ms)"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding SelectedCamera.Timeout, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding SelectedCamera.Use}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <TextBlock Text="{Binding ValidationError}"
                       Foreground="Red"
                       FontSize="11"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding HasValidationError}" Value="True">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>

            <Button Content="불러오기"
                    Margin="0,0,8,0"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding LoadCommand}"/>

            <Button Content="저장"
                    Margin="0,0,8,0"
                    Style="{StaticResource DialogPrimaryButtonStyle}"
                    Command="{Binding SaveCommand}"/>

            <Button Content="닫기"
                    IsCancel="True"
                    Style="{StaticResource DialogSecondaryButtonStyle}"
                    Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
