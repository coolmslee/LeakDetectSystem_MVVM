<Window x:Class="LeakDetectSystem_MVVM.Views.Dialogs.CameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels.Dialogs"
        Title="Camera 설정" Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Window.DataContext>
        <vm:CameraDialogViewModel />
    </Window.DataContext>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="카메라 설정" FontSize="16" FontWeight="Bold" Margin="0,0,0,12"/>

        <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="1" Padding="12">
            <StackPanel>
                <!-- CAM1~CAM4 Use + IP -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="1" Text="Use" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBlock Grid.Column="2" Text="IP Address" FontWeight="SemiBold" Margin="6,0,0,0" VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM1" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam1Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam1Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam1Use}" Margin="6,2,0,2" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM2" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam2Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam2Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam2Use}" Margin="6,2,0,2" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM3" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam3Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam3Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam3Use}" Margin="6,2,0,2" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM4" VerticalAlignment="Center"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam4Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam4Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam4Use}" Margin="6,2,0,2" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>

                <Separator Margin="0,6"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="노출 시간 (μs)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="게인 (%)" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Padding="4,3" BorderBrush="Gray" BorderThickness="1"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="닫기" Width="80" Height="30" IsCancel="True" Click="CloseButton_Click"/>
        </StackPanel>
    </Grid>
</Window>
