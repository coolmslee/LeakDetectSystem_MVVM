<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.CameraDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Camera 설정" Height="460" Width="480"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="카메라 설정" Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <!-- CAM1~CAM4 Use + IP -->
                <Grid Margin="0,0,0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM" Style="{StaticResource DialogHeaderLabelTextStyle}"/>
                    <TextBlock Grid.Column="1" Text="Use" HorizontalAlignment="Center" Style="{StaticResource DialogHeaderLabelTextStyle}"/>
                    <TextBlock Grid.Column="2" Text="IP Address" Margin="6,0,0,0" Style="{StaticResource DialogHeaderLabelTextStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM1" Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam1Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam1Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam1Use}" Margin="6,2,0,2" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM2" Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam2Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam2Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam2Use}" Margin="6,2,0,2" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM3" Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam3Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam3Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam3Use}" Margin="6,2,0,2" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="60"/>
                        <ColumnDefinition Width="50"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="CAM4" Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding Cam4Use}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="2" Text="{Binding Cam4Ip, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding Cam4Use}" Margin="6,2,0,2" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Separator Margin="0,6"/>

                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="노출 시간 (μs)" Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding ExposureTime, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="게인 (%)" Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding Gain, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <Button Content="닫기" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
