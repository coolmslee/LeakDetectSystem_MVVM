<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.GrabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Grab 설정" Height="320" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Grab 설정" Style="{StaticResource DialogTitleTextStyle}"/>

        <Border Grid.Row="1" Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="트리거 모드" Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding TriggerMode, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="타임아웃 (ms)" Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1" Text="{Binding GrabTimeout, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="연속 그랩" Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1" IsChecked="{Binding IsContinuous}" VerticalAlignment="Center"/>
                </Grid>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="2" Style="{StaticResource DialogFooterPanelStyle}">
            <Button Content="닫기" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
