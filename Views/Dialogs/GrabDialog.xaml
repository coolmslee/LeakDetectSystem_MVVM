<dialogs:DialogWindowBase x:Class="LeakDetectSystem_MVVM.Views.Dialogs.GrabDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:dialogs="clr-namespace:LeakDetectSystem_MVVM.Views.Dialogs"
        Title="Grab 설정" Height="430" Width="460"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{DynamicResource SurfaceBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                   Text="Grab 설정"
                   Margin="0,0,0,8"/>

        <Border Grid.Row="1"
                Margin="0,0,0,10"
                Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="Grab 설정"
                           Margin="0,0,0,10"
                           Style="{StaticResource DialogHeaderLabelTextStyle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Interval"
                               VerticalAlignment="Center"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding Interval, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Image Save"
                               VerticalAlignment="Center"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <CheckBox Grid.Column="1"
                              IsChecked="{Binding ImageSave}"
                              VerticalAlignment="Center"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="Image Format"
                               VerticalAlignment="Center"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding ImageExtensions}"
                              SelectedItem="{Binding SelectedImageExtension}"
                              MinWidth="120"/>
                </Grid>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="Grab 저장"
                            Command="{Binding SaveGrabSettingsCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,10"
                Style="{StaticResource DialogSectionBorderStyle}">
            <StackPanel>
                <TextBlock Text="HDD Setting"
                           Margin="0,0,0,10"
                           Style="{StaticResource DialogHeaderLabelTextStyle}"/>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Text="HDD Setting Space (GB)"
                               VerticalAlignment="Center"
                               Style="{StaticResource DialogLabelTextStyle}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding HddSettingSpace, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource DialogInputTextBoxStyle}"/>
                </Grid>

                <TextBlock Text="기준 용량 미만 시 가장 오래된 이미지를 삭제해 D 드라이브 공간을 확보합니다."
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource TextSecondaryBrush}"
                           Margin="0,0,0,12"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right">
                    <Button Content="HDD 저장"
                            Command="{Binding SaveHddSettingsCommand}"
                            Style="{StaticResource DialogPrimaryButtonStyle}"/>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Grid.Row="3" Style="{StaticResource DialogFooterPanelStyle}">
            <TextBlock Text="{Binding StatusMessage}"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       Foreground="{DynamicResource TextSecondaryBrush}"/>
            <Button Content="닫기" IsCancel="True" Style="{StaticResource DialogSecondaryButtonStyle}" Command="{Binding CloseCommand}"/>
        </StackPanel>
    </Grid>
</dialogs:DialogWindowBase>
