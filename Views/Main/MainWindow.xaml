<Window x:Class="LeakDetectSystem_MVVM.Views.Main.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
        xmlns:controls="clr-namespace:LeakDetectSystem_MVVM.Views.Main.Controls"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel, IsDesignTimeCreatable=True}"
        Title="{Binding Title}"
        Width="960" Height="640"
        MinWidth="720" MinHeight="480"
        WindowStartupLocation="CenterScreen">

    <!-- DataTemplate: ViewModel 타입에 따라 어떤 View를 렌더링할지 매핑합니다. -->
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:MainTabViewModel}">
            <controls:MainTabView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingTabViewModel}">
            <controls:SettingTabView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <!-- 메뉴바 -->
            <RowDefinition Height="Auto" />
            <!-- 탭 컨트롤 영역 -->
            <RowDefinition Height="*" />
            <!-- 상태 표시줄 -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ===== 상단 TitleBar ===== -->
        <controls:TitleBarView Grid.Row="0"
                               DataContext="{Binding TitleBar}" />

        <!-- ===== TabControl: ViewModel 기반 탭 바인딩 ===== -->
        <!--
            TabControl의 ItemsSource 대신, SelectedItem을 ContentControl로 표현하는
            "ContentControl + DataTemplate" 패턴을 사용합니다.
            탭 헤더 버튼은 명시적으로 상단에 배치하여 NavigateCommand와 바인딩합니다.
        -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- 탭 헤더 버튼 영역 -->
            <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Background="{StaticResource PrimaryBrush}">
                <Button Content="Main"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="main"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="2,4" />
                <Button Content="Setting"
                        Command="{Binding NavigateCommand}"
                        CommandParameter="setting"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Margin="2,4" />
            </StackPanel>

            <!-- 탭 콘텐츠 영역: DataTemplate에 의해 자동으로 올바른 View가 표시됩니다 -->
            <ContentControl Grid.Row="1"
                            Content="{Binding SelectedTab}" />
        </Grid>

        <!-- ===== 하단 상태 표시줄 ===== -->
        <StatusBar Grid.Row="2"
                   Background="{StaticResource PrimaryDarkBrush}">
            <StatusBarItem>
                <TextBlock Text="{Binding FooterStatus}"
                           Foreground="{StaticResource TextOnPrimaryBrush}"
                           FontSize="11" />
            </StatusBarItem>
        </StatusBar>
    </Grid>
</Window>
