<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.StationDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StationCardViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="200" d:DesignWidth="280">

    <!--
        StationDisplayView: Cognex CogDisplay 이미지 표시 영역 + LIVE / 1:1 / FIT 버튼 영역.
        CogDisplay 는 WinForms 컨트롤이므로 WindowsFormsHost 로 감싸 WPF 에 통합합니다.
        CogDisplay 인스턴스는 StationDisplayView.xaml.cs 코드비하인드에서 생성 및 초기화합니다.
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── CogDisplay 표시 영역 (WindowsFormsHost) ─────────────────── -->
        <Border Grid.Row="0"
                BorderBrush="{DynamicResource CardBorderBrush}"
                BorderThickness="1"
                ClipToBounds="True">
            <Grid>
                <!--
                    WindowsFormsHost 에 CogDisplay 를 삽입합니다.
                    x:Name="CogDisplayHost" 는 코드비하인드에서 참조합니다.
                -->
                <WindowsFormsHost x:Name="CogDisplayHost"
                                  MinHeight="150" />

                <!-- 스테이션 이름 레이블 (좌상단) – CogDisplay 위에 오버레이 -->
                <TextBlock Text="{Binding StationName}"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="8,6"
                           IsHitTestVisible="False" />

                <!-- 압력값 표시 (하단 오버레이) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,6"
                            IsHitTestVisible="False">
                    <TextBlock Text="P: "
                               Foreground="#AAAAAA"
                               FontSize="10" />
                    <TextBlock FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} kPa">
                                <Binding Path="PressureValue" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboveThreshold}" Value="True">
                                        <Setter Property="Foreground" Value="{DynamicResource ErrorStatusBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- LIVE 표시 뱃지 (우상단) -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        Background="#CC0000"
                        CornerRadius="3"
                        Padding="4,2"
                        IsHitTestVisible="False">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="LIVE"
                               Foreground="#FFFFFF"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- ── 표시 모드 버튼: LIVE / 1:1 / FIT ─────────────────────────── -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0">
            <Button Content="LIVE"
                    Command="{Binding LiveCommand}"
                    Margin="2,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="1:1"
                    Command="{Binding OneToOneCommand}"
                    Margin="2,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOneToOne}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>

            <Button Content="FIT"
                    Command="{Binding FitCommand}"
                    Margin="2,0">
                <Button.Style>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFitMode}" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Style>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
