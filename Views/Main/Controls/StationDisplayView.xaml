<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.StationDisplayView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:StationCardViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="200" d:DesignWidth="280">

    <!--
        StationDisplayView: CogDisplay 이미지 표시 영역 + LIVE / 1:1 / FIT 버튼 영역
        원본(LeakDetectSystem) 기준:
          - <cog:CogDisplay x:Name="CogDisplay_ST1" /> 자리 → Border Placeholder 로 대체
          - Cognex VisionPro(CogDisplay) 의존성 없이 빌드 가능
          - 실제 도입 시 Placeholder Border 를 <cog:CogDisplay> 로 교체
    -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ── CogDisplay Placeholder ────────────────────────────────────── -->
        <!-- 원본 대응 위치: <cog:CogDisplay x:Name="CogDisplay_ST{n}" />   -->
        <Border Grid.Row="0"
                Background="#1A1A2E"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1"
                MinHeight="150"
                ClipToBounds="True">
            <Grid>
                <!-- 스테이션 이름 레이블 (좌상단) -->
                <TextBlock Text="{Binding StationName}"
                           Foreground="#FFFFFF"
                           FontSize="13"
                           FontWeight="Bold"
                           HorizontalAlignment="Left"
                           VerticalAlignment="Top"
                           Margin="8,6" />

                <!-- CogDisplay 자리 안내 텍스트 -->
                <TextBlock Text="[ CogDisplay ]"
                           Foreground="#4A6FA5"
                           FontSize="11"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Opacity="0.5" />

                <!-- 압력값 표시 (하단) -->
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Margin="8,0,0,6">
                    <TextBlock Text="P: "
                               Foreground="#AAAAAA"
                               FontSize="10" />
                    <TextBlock FontSize="10">
                        <TextBlock.Text>
                            <MultiBinding StringFormat="{}{0:F1} kPa">
                                <Binding Path="PressureValue" />
                            </MultiBinding>
                        </TextBlock.Text>
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#AAAAAA" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsAboveThreshold}" Value="True">
                                        <Setter Property="Foreground" Value="{StaticResource ErrorStatusBrush}" />
                                        <Setter Property="FontWeight" Value="Bold" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </StackPanel>

                <!-- LIVE 표시 뱃지 (우상단, IsLive=True 일 때만 표시) -->
                <Border HorizontalAlignment="Right"
                        VerticalAlignment="Top"
                        Margin="0,4,4,0"
                        Background="#CC0000"
                        CornerRadius="3"
                        Padding="4,2">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLive}" Value="True">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="LIVE"
                               Foreground="#FFFFFF"
                               FontSize="10"
                               FontWeight="Bold" />
                </Border>
            </Grid>
        </Border>

        <!-- ── 표시 모드 버튼: LIVE / 1:1 / FIT ─────────────────────────── -->
        <!-- 원본 대응: CogDisplay 하단 LIVE/FIT/+/-/1:1 버튼 영역          -->
        <StackPanel Grid.Row="1"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,4,0,0">
            <Button Content="LIVE"
                    Command="{Binding LiveCommand}"
                    Style="{StaticResource DisplayModeButtonStyle}"
                    Margin="2,0">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsLive}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="1:1"
                    Command="{Binding OneToOneCommand}"
                    Style="{StaticResource DisplayModeButtonStyle}"
                    Margin="2,0">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsOneToOne}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
            <Button Content="FIT"
                    Command="{Binding FitCommand}"
                    Style="{StaticResource DisplayModeButtonStyle}"
                    Margin="2,0">
                <Button.Resources>
                    <Style TargetType="Button" BasedOn="{StaticResource DisplayModeButtonStyle}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsFitMode}" Value="True">
                                <Setter Property="Background" Value="{StaticResource AccentBrush}" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Button.Resources>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
