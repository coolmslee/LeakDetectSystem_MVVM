<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.MainTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             xmlns:controls="clr-namespace:LeakDetectSystem_MVVM.Views.Main.Controls"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:MainTabViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="500" d:DesignWidth="800">

    <Grid Background="{DynamicResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단 대시보드 (원본 SearchPanel 구성: CAM 선택/검사PASS/수량/연결상태/SEQ/자동시작) -->
        <controls:MainTopDashboardView Grid.Row="0"
                                       DataContext="{Binding Dashboard}"
                                       Margin="0" />

        <!-- Signal/Process 패널 (MODEL / QRcode / 검사진행상태 / 수동검사 / STOP) -->
        <controls:SignalProcessPanelView Grid.Row="1"
                                         DataContext="{Binding SignalProcess}"
                                         Margin="0" />

        <!-- 연결상태/요청신호/통신 상태 패널 (PLC●|카메라●|IMQS●|RFID●) -->
        <controls:ConnectionStatePanelView Grid.Row="2"
                                           DataContext="{Binding ConnectionState}"
                                           Margin="0" />

        <!-- 스테이션 그룹 뷰 (설정 완료된 CAM 수만큼 ST 표시) -->
        <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto" Padding="8">
            <controls:StationGroupView DataContext="{Binding StationGroup}" />
        </ScrollViewer>

        <!-- 하단 상태 표시줄 -->
        <Border Grid.Row="4"
                Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,1,0,0"
                Padding="12,6">
            <TextBlock Text="{Binding StatusText}"
                       Style="{StaticResource SecondaryTextStyle}" />
        </Border>
    </Grid>
</UserControl>
