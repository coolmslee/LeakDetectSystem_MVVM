<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.SettingTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingTabViewModel, IsDesignTimeCreatable=True}"
             d:DesignHeight="800" d:DesignWidth="1180">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Background="{DynamicResource BackgroundBrush}" Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ====== Header ====== -->
            <TextBlock Grid.Row="0"
                       Text="Setting"
                       Style="{StaticResource HeaderTextStyle}"
                       Margin="2,0,0,10"/>

            <!-- ====== Row 1: PLC Memory / PC Memory ====== -->
            <Border Grid.Row="1" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <GroupBox Header="PLC Memory / PC Memory" FontWeight="Bold" FontSize="14"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- PLC IP row (read-only: PLC 통신 메뉴에서 설정) -->
                        <Grid Grid.Row="0" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="10"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="100"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PLC IP" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcIpAddress, Mode=OneWay}" Padding="4,2"
                                     IsReadOnly="True" Background="{DynamicResource PanelBackgroundBrush}"/>
                            <TextBlock Grid.Column="3" Text="Port" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            <TextBox Grid.Column="4" Text="{Binding PlcPort, Mode=OneWay}" Padding="4,2"
                                     IsReadOnly="True" Background="{DynamicResource PanelBackgroundBrush}"/>
                        </Grid>

                        <!-- Start address row -->
                        <Grid Grid.Row="1" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="110"/>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="12"/>
                                <ColumnDefinition Width="90"/>
                                <ColumnDefinition Width="140"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Start Address" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcStartAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="PC Memory" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcStartAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <!-- Column header row -->
                        <Grid Grid.Row="2" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="PLC Memory" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="Address" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="3" Text="PC Memory" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="4" Text="Address" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Address mapping rows -->
                        <Grid Grid.Row="3" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Heart Beat" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcHeartBeatAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="Heart Beat" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcHeartBeatAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <Grid Grid.Row="4" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bottle Rolling" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcBottleRollingAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="Vision Ready" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcVisionReadyAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <Grid Grid.Row="5" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="검사 요청" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcInspectRequestAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="검사 완료" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcInspectDoneAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <Grid Grid.Row="6" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reset1 Req" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcReset1ReqAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="Reset1 Ack" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcReset1AckAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <Grid Grid.Row="7" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Reset2 Ack" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcReset2AckAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="Reset2 Req" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcReset2ReqAddress}" Margin="2" Padding="4,2"/>
                        </Grid>

                        <Grid Grid.Row="8" Margin="0,2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="160"/>
                                <ColumnDefinition Width="120"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Bottle Data Ack" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding PlcBottleDataAckAddress}" Margin="2" Padding="4,2"/>
                            <TextBlock Grid.Column="3" Text="Bottle Data Req" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="4" Text="{Binding PcBottleDataReqAddress}" Margin="2" Padding="4,2"/>
                        </Grid>
                    </Grid>
                </GroupBox>
            </Border>

            <!-- Save button for Memory -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,0,10">
                <Button Content="Save"
                        Command="{Binding SaveMemoryCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80"/>
            </StackPanel>

            <!-- ====== Row 2: Times ====== -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}" Margin="0,0,0,10">
                <GroupBox Header="Times" FontWeight="Bold" FontSize="14"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="160"/>
                            <ColumnDefinition Width="100"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Bottle Turn (ms)" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding BottleTurnTime, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,0,2"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="ms" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Inspect Req. (ms)" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding InspectReqTime, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,0,2"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="ms" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Inspect End (ms)" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="0,2"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding InspectEndTime, UpdateSourceTrigger=PropertyChanged}" Padding="4,2" Margin="0,2,0,2"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="ms" Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center" Margin="6,0,0,0"/>
                    </Grid>
                </GroupBox>
            </Border>

            <!-- Save button for Times -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right"
                        VerticalAlignment="Bottom" Margin="0,0,0,10">
                <Button Content="Save"
                        Command="{Binding SaveTimesCommand}"
                        Style="{StaticResource PrimaryButtonStyle}"
                        Width="80"/>
            </StackPanel>

            <!-- ====== Row 3: PLC Memory / PC Memory (DIO) ====== -->
            <Grid Grid.Row="3" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- PLC Memory (0~15 Ellipse read-only indicators) -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Margin="0,0,6,0">
                    <GroupBox Header="PLC Memory" FontWeight="Bold" FontSize="14"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <ItemsControl Margin="6" ItemsSource="{Binding DioInputStates}"
                                      AlternationCount="16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Vertical" Margin="4" Width="38" HorizontalAlignment="Center">
                                        <Ellipse Width="20" Height="20" HorizontalAlignment="Center">
                                            <Ellipse.Style>
                                                <Style TargetType="Ellipse">
                                                    <Setter Property="Fill" Value="{DynamicResource InactiveStatusBrush}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding}" Value="True">
                                                            <Setter Property="Fill" Value="{DynamicResource NormalStatusBrush}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Ellipse.Style>
                                        </Ellipse>
                                        <TextBlock HorizontalAlignment="Center" FontSize="10"
                                                   Text="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                          Path=(ItemsControl.AlternationIndex)}"
                                                   Foreground="{DynamicResource TextSecondaryBrush}"/>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </Border>

                <!-- PC Memory (0~15 ToggleButton) -->
                <Border Grid.Column="1" Style="{StaticResource CardStyle}" Margin="6,0,0,0">
                    <GroupBox Header="PC Memory" FontWeight="Bold" FontSize="14"
                              Foreground="{DynamicResource TextPrimaryBrush}">
                        <ItemsControl Margin="6" ItemsSource="{Binding DioOutputStates}"
                                      AlternationCount="16">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <ToggleButton Style="{StaticResource DioOutputToggleStyle}"
                                                  IsChecked="{Binding Mode=OneWay}"
                                                  Content="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                             Path=(ItemsControl.AlternationIndex)}"
                                                  Tag="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                        Path=(ItemsControl.AlternationIndex)}"
                                                  Command="{Binding DataContext.ToggleDioOutputCommand,
                                                            RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                  CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=ContentPresenter},
                                                                     Path=(ItemsControl.AlternationIndex)}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </GroupBox>
                </Border>
            </Grid>

            <!-- ====== Row 4: 조명 제어 ====== -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <GroupBox Header="조명 제어" FontWeight="Bold" FontSize="14"
                          Foreground="{DynamicResource TextPrimaryBrush}">
                    <Grid Margin="6">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Column header -->
                        <Grid Grid.Row="0" Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="80"/>
                                <ColumnDefinition Width="80"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="채널" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}"/>
                            <TextBlock Grid.Column="1" Text="밝기" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="On/Off" FontWeight="SemiBold" Style="{StaticResource BodyTextStyle}" HorizontalAlignment="Center"/>
                        </Grid>

                        <!-- Channel rows -->
                        <ItemsControl Grid.Row="1" ItemsSource="{Binding LightChannels}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="80"/>
                                            <ColumnDefinition Width="80"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Grid.Column="0" Text="{Binding DisplayName}"
                                                   Style="{StaticResource BodyTextStyle}" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding BrightnessText}"
                                                   Style="{StaticResource BodyTextStyle}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <ToggleButton Grid.Column="2"
                                                      HorizontalAlignment="Center"
                                                      Style="{StaticResource DioOutputToggleStyle}"
                                                      Width="52" Height="24"
                                                      IsChecked="{Binding IsOn, Mode=OneWay}"
                                                      Content="{Binding StatusText}"
                                                      Command="{Binding DataContext.ToggleLightCommand,
                                                                RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                      CommandParameter="{Binding}"/>
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </GroupBox>
            </Border>
        </Grid>
    </ScrollViewer>
</UserControl>
