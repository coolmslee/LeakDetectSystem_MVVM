<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TitleBarViewModel, IsDesignTimeCreatable=True}"
             Height="55"
             Background="{StaticResource PrimaryDarkBrush}">

    <!--
        TitleBarView: 상단 55px 헤더 영역
        왼쪽: 타이틀 + 기능 메뉴 버튼 (PLC / Model / Camera / Grab / Light / MENU / RFID / LOG)
        오른쪽: 현재 날짜/시간 + EXIT 버튼
    -->
    <Grid>
        <Grid.ColumnDefinitions>
            <!-- 좌측: 타이틀 + 메뉴 버튼 그룹 -->
            <ColumnDefinition Width="*" />
            <!-- 우측: 시간 표시 + EXIT -->
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- ===== 좌측: 타이틀 + 기능 버튼 ===== -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0">

            <!-- 타이틀 -->
            <TextBlock Text="누설 감지 시스템"
                       Foreground="{StaticResource TextOnPrimaryBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />

            <!-- 구분선 -->
            <Rectangle Width="1" Height="28"
                       Fill="{StaticResource PrimaryLightBrush}"
                       Margin="0,0,12,0" />

            <!-- PLC -->
            <Button Content="PLC"
                    Command="{Binding OpenPlcCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="PLC 설정" />

            <!-- Model -->
            <Button Content="Model"
                    Command="{Binding OpenModelCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="Model 설정" />

            <!-- Camera -->
            <Button Content="Camera"
                    Command="{Binding OpenCameraCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="Camera 설정" />

            <!-- Grab -->
            <Button Content="Grab"
                    Command="{Binding OpenGrabCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="Grab 설정" />

            <!-- Light -->
            <Button Content="Light"
                    Command="{Binding OpenLightCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="Light 설정" />

            <!-- 구분선 -->
            <Rectangle Width="1" Height="28"
                       Fill="{StaticResource PrimaryLightBrush}"
                       Margin="4,0" />

            <!-- MENU -->
            <Button Content="MENU"
                    Command="{Binding OpenMenuCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="메뉴 열기" />

            <!-- RFID -->
            <Button Content="RFID"
                    Command="{Binding ShowRfidCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="RFID 창 열기" />

            <!-- LOG -->
            <Button Content="LOG"
                    Command="{Binding ShowLogCommand}"
                    Style="{StaticResource TitleBarMenuButtonStyle}"
                    ToolTip="LOG 창 열기" />
        </StackPanel>

        <!-- ===== 우측: 날짜/시간 + EXIT ===== -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">

            <!-- 날짜/시간 -->
            <TextBlock Text="{Binding CurrentTime}"
                       Foreground="{StaticResource TextOnPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       FontFamily="Consolas" />

            <!-- 구분선 -->
            <Rectangle Width="1" Height="28"
                       Fill="{StaticResource PrimaryLightBrush}"
                       Margin="0,0,8,0" />

            <!-- EXIT -->
            <Button Content="EXIT"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource TitleBarExitButtonStyle}"
                    ToolTip="프로그램 종료" />
        </StackPanel>
    </Grid>
</UserControl>
