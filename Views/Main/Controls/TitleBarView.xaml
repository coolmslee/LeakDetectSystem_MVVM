<UserControl x:Class="LeakDetectSystem_MVVM.Views.Main.Controls.TitleBarView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:LeakDetectSystem_MVVM.ViewModels"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:TitleBarViewModel, IsDesignTimeCreatable=True}"
             Height="55"
             Background="{DynamicResource PrimaryDarkBrush}">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <!-- 좌측: 타이틀 + 메뉴 -->
        <StackPanel Grid.Column="0"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="8,0">
            <TextBlock Text="누설 감지 시스템"
                       Foreground="{DynamicResource TextOnPrimaryBrush}"
                       FontSize="16"
                       FontWeight="Bold"
                       VerticalAlignment="Center"
                       Margin="0,0,16,0" />
            <Rectangle Width="1" Height="28"
                       Fill="{DynamicResource PrimaryLightBrush}"
                       Margin="0,0,8,0" />
            <Menu Background="Transparent"
                  VerticalAlignment="Center"
                  Style="{StaticResource TitleBarMenuStyle}">
                <MenuItem Header="MENU"
                          Foreground="{DynamicResource TextOnPrimaryBrush}"
                          Background="Transparent"
                          BorderThickness="0"
                          FontSize="16"
                          FontWeight="Bold"
                          Padding="10,6">
                    <MenuItem Header="PLC"
                              Command="{Binding OpenPlcCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                    <MenuItem Header="Model"
                              Command="{Binding OpenModelCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                    <MenuItem Header="Camera"
                              Command="{Binding OpenCameraCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                    <MenuItem Header="Grab"
                              Command="{Binding OpenGrabCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                    <MenuItem Header="Light"
                              Command="{Binding OpenLightCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                    <Separator />
                    <MenuItem Header="Log"
                              Command="{Binding ShowLogCommand}"
                              Foreground="{DynamicResource TextPrimaryBrush}"
                              Background="{DynamicResource SurfaceBrush}"
                              BorderThickness="0"
                              FontSize="14"
                              Padding="12,6" />
                </MenuItem>
            </Menu>
        </StackPanel>

        <!-- 우측: 날짜/시간 + EXIT -->
        <StackPanel Grid.Column="1"
                    Orientation="Horizontal"
                    VerticalAlignment="Center"
                    Margin="0,0,8,0">
            <TextBlock Text="{Binding CurrentTime}"
                       Foreground="{DynamicResource TextOnPrimaryBrush}"
                       FontSize="13"
                       VerticalAlignment="Center"
                       Margin="0,0,12,0"
                       FontFamily="Consolas" />
            <Rectangle Width="1" Height="28"
                       Fill="{DynamicResource PrimaryLightBrush}"
                       Margin="0,0,8,0" />
            <Button Content="EXIT"
                    Command="{Binding ExitCommand}"
                    Style="{StaticResource TitleBarExitButtonStyle}"
                    ToolTip="프로그램 종료" />
        </StackPanel>
    </Grid>
</UserControl>
